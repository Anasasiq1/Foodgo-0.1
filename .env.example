# Application Details
APP_NAME="Foodgo"
APP_URL="https://example.com"
APP_ENV="production"
APP_SECRET="YOUR_RANDOM_CRYPTOGRAPHIC_SECRET_KEY_HERE"
PORT=3000

# Database Configuration (MySQL / MariaDB)
DB_HOST="localhost"
DB_PORT=3306
DB_DATABASE="foodgo_db"
DB_USERNAME="foodgo_user"
DB_PASSWORD="your_secure_password"

# UPI & Instant Payment Defaults
UPI_ID="foodgo@upi"
UPI_MERCHANT_NAME="Foodgo Foods Pvt Ltd"
VITE_MERCHANT_UPI_ID="foodgo@upi"

# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY=""
